NAME = ft_hexdump
CC = cc
CFLAGS = -Wall -Wextra -Werror
SRC = ft_hexdump.c ft_hexdump_dump.c ft_hexdump_utils.c
OBJ = $(SRC:.c=.o)

all: $(NAME)

$(NAME): $(OBJ)
	$(CC) $(CFLAGS) -o $(NAME) $(OBJ)

%.o: %.c ft_hexdump.h
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re
